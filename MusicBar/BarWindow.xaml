<Window x:Class="MusicBar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Bar" Width="300" Height="40"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource TextFont}">
  <Border x:Name="Bar" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
          BorderThickness="1" CornerRadius="6" MouseWheel="Bar_MouseWheel"
          MouseUp="Bar_MouseUp">
    <Border.ContextMenu>
      <ContextMenu Opened="Menu_Opened">
        <MenuItem Header="Quit Music Bar" Click="Quit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <Grid Margin="0,0,3,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Drag this thin line left or right to resize the bar -->
      <Border x:Name="Grip" Width="9" Background="Transparent" Cursor="SizeWE"
              MouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove" MouseLeftButtonUp="Grip_MouseUp"
              LostMouseCapture="Grip_LostCapture">
        <Rectangle Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="#40FFFFFF" HorizontalAlignment="Center" />
      </Border>

      <!-- Hovering over the cover and song text opens the queue window; clicking it opens Spotify -->
      <Grid x:Name="HoverZone" Grid.Column="1" Background="Transparent" MouseLeftButtonUp="HoverZone_Click">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="SongShift" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Cover" Width="28" Height="28" CornerRadius="4" Background="{StaticResource Hover}">
          <TextBlock x:Name="CoverPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                     Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,5">
          <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ArtistText" FontSize="11" Foreground="{StaticResource TextSecondary}"
                     TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </StackPanel>
      </Grid>

      <StackPanel x:Name="ButtonsPanel" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                  VerticalAlignment="Center">
        <StackPanel.RenderTransform>
          <TranslateTransform x:Name="ButtonsShift" />
        </StackPanel.RenderTransform>
        <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                IsEnabled="False" Click="Previous_Click" />
        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" RenderTransformOrigin="0.5,0.5"
                IsEnabled="False" Click="PlayPause_Click" />
        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                IsEnabled="False" Click="Next_Click" />
      </StackPanel>

      <!-- Song progress: a thin line along the bottom. Click or drag along it to jump in the song. -->
      <Grid x:Name="ProgressZone" Grid.Column="1" Grid.ColumnSpan="4" Height="7" VerticalAlignment="Bottom"
            Margin="36,0,6,0" Background="Transparent" Cursor="Hand" Visibility="Hidden"
            MouseLeftButtonDown="Progress_MouseDown" MouseMove="Progress_MouseMove"
            MouseLeftButtonUp="Progress_MouseUp" LostMouseCapture="Progress_LostCapture">
        <Border x:Name="ProgressTrack" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1"
                CornerRadius="1" Background="#12FFFFFF" />
        <Border x:Name="ProgressFill" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1" Width="0"
                HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource SpotifyGreen}" />
      </Grid>

      <!-- Shown briefly in place of the buttons while you scroll to change the volume -->
      <StackPanel x:Name="VolumePanel" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
        <StackPanel.RenderTransform>
          <TranslateTransform x:Name="VolumeShift" Y="5" />
        </StackPanel.RenderTransform>
        <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        <!-- Nudged up 1px: the text font sits slightly lower than the icon font -->
        <TextBlock x:Name="VolumeText" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center">
          <TextBlock.RenderTransform>
            <TranslateTransform Y="-1" />
          </TextBlock.RenderTransform>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Border>
</Window>
